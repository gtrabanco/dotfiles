# Load secrets from a .env file as exported vars, and redact them from `env`.
# Source this from ~/.bashrc:  source ~/.bash_env_secrets.sh

# Tracks which var names came from the .env file (redacted later).
declare -ag ENV_SECRET_VARS=()
SECRETS_ENV_FILE=${SECRETS_ENV_FILE:-${HOME}/.config/secrets/.env}

load_env_secrets() {
    local envfile="${1:-${SECRETS_ENV_FILE}}"
    [ -f "$envfile" ] || return 0

    ENV_SECRET_VARS=()

    local line key value
    while IFS= read -r line || [ -n "$line" ]; do
        # skip blank lines and comments
        [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
        # must look like KEY=VALUE (used only as a boolean filter now)
        [[ "$line" =~ ^[[:space:]]*[A-Za-z_][A-Za-z0-9_]*=.*$ ]] || continue

        # strip leading whitespace, then split on the first '='
        line="${line#"${line%%[![:space:]]*}"}"
        key="${line%%=*}"
        value="${line#*=}"
        # strip surrounding quotes if present
        value="${value%\"}"; value="${value#\"}"
        value="${value%\'}"; value="${value#\'}"

        export "$key=$value"
        ENV_SECRET_VARS+=("$key")
    done < "$envfile"
}

# `env` override: same output, secret values replaced with <redacted>
env() {
    local line key
    while IFS= read -r line; do
        key="${line%%=*}"
        local is_secret=0
        for s in "${ENV_SECRET_VARS[@]}"; do
            [[ "$key" == "$s" ]] && { is_secret=1; break; }
        done
        if [ "$is_secret" -eq 1 ]; then
            echo "${key}=<redacted>"
        else
            echo "$line"
        fi
    done < <(command env)
}

load_env_secrets